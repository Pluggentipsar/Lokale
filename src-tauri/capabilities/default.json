{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions för huvudfönstret.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "sql:default",
      "allow": [
        { "name": "sqlite:lokale.db" }
      ]
    },
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
